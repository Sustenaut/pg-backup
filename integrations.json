{
  "uses": [
    {
      "plugin": "bitwarden.secrets",
      "paths": [
        "tests/test_cli_setup.py",
        "tests/test_need.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.app-token",
      "paths": [
        ".github/workflows/main.yml",
        ".github/workflows/pr.yml"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.board-read",
      "paths": [
        ".github/workflows/publish.yml"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.ghcr",
      "paths": [
        ".github/workflows/publish.yml",
        "tests/conftest.py",
        "tests/test_restore.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "google.cloud",
      "paths": [
        "src/pg_backup/need.py",
        "src/pg_backup/setup.py",
        "tests/test_need.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "sonarcloud.read",
      "paths": [
        ".github/workflows/main.yml",
        ".github/workflows/pr.yml"
      ],
      "mode": "required"
    },
    {
      "plugin": "terraform.google",
      "paths": [
        "terraform/wal-archive/versions.tf"
      ],
      "mode": "required"
    }
  ],
  "own_hosts": [
    "sustenaut.eu"
  ]
}
